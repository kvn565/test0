# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

# -- SECURITE PROD (ajout SAFE : ne touche pas Passenger, bloque fichiers sensibles) --
<IfModule mod_rewrite.c>
RewriteEngine On
# Bloque .git, .env, sqlite, logs, venv en 403 (pas d'erreur 500 si absent)
RewriteRule ^\.git - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^db\.sqlite3 - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^venv/ - [F,L]
RewriteRule ^__pycache__/ - [F,L]
# Projet sans git : bloque fichiers git stray exposes a la racine (HEAD, config, hooks/, objects/, refs/, etc.)
RewriteRule ^HEAD$ - [F,L]
RewriteRule ^config$ - [F,L]
RewriteRule ^COMMIT_EDITMSG$ - [F,L]
RewriteRule ^ORIG_HEAD$ - [F,L]
RewriteRule ^FETCH_HEAD$ - [F,L]
RewriteRule ^description$ - [F,L]
RewriteRule ^hooks/ - [F,L]
RewriteRule ^objects/ - [F,L]
RewriteRule ^refs/ - [F,L]
RewriteRule ^info/ - [F,L]
</IfModule>
# Double protection compatible Apache 2.4
<FilesMatch "^\.env$|^db\.sqlite3$">
Require all denied
</FilesMatch>